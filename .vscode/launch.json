{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Qt Application (GDB/MinGW)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [],
            "stopAtEntry": false,
            "preLaunchTask": "CMake: build",
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "PATH",
                    "value": "C:\\Qt\\6.11.1\\mingw_64\\bin;C:\\Qt\\Tools\\mingw1310_64\\bin;${env:PATH}"
                },
                {
                    "name": "QT_PLUGIN_PATH",
                    "value": "C:\\Qt\\6.11.1\\mingw_64\\plugins"
                },
                {
                    "name": "QT_MEDIA_BACKEND",
                    "value": "ffmpeg"
                },
                {
                    "name": "QT_LOGGING_RULES",
                    "value": "qt.multimedia.*=true"
                }
            ],
            "MIMode": "gdb",
            "miDebuggerPath": "C:\\Qt\\Tools\\mingw1310_64\\bin\\gdb.exe",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
